# ревизия весов DeepSeek V4-Flash (HF commit, сверено с MODEL_CARD.md)
MODEL_REVISION=60d8d70770c6776ff598c94bb586a859a38244f1
VLLM_API_KEY=change-me
HF_HOME=/mnt/models/hf
# Учитель для дистилляции (OpenAI-совместимый агрегатор polza.ai).
# Ключ генерируется в личном кабинете; .env в .gitignore.
TEACHER_BASE=https://polza.ai/api
TEACHER_KEY=
TEACHER_MODEL=

# --- EVA: гибридный ассистент (docs/hybrid.md, docs/integration-orioncode.md) ---
# Малая модель — локальный OpenAI-совместимый сервер (vLLM/Ollama).
EVA_SMALL_BASE=http://127.0.0.1:8001/v1
EVA_SMALL_KEY=
EVA_SMALL_MODEL=eva-small
EVA_SMALL_TIMEOUT=30
EVA_SMALL_RETRIES=1
EVA_SMALL_PRICE_PROMPT=0.0
EVA_SMALL_PRICE_COMPLETION=0.0

# Большая модель — облачный провайдер. Пустые BASE/MODEL = большой модели нет,
# всё, что не скилл, уйдёт в малую.
EVA_BIG_BASE=
EVA_BIG_KEY=
EVA_BIG_MODEL=
EVA_BIG_TIMEOUT=60
EVA_BIG_RETRIES=2
EVA_BIG_PRICE_PROMPT=0.4
EVA_BIG_PRICE_COMPLETION=1.2

# Бюджет на запрос, ₽ (none — без лимита) и лимит completion-токенов.
EVA_MAX_COST_RUB=5.0
EVA_MAX_TOKENS=512

# Пороги классификатора; маркеры — через запятую.
EVA_CLASSIFIER_LONG_CHARS=120
EVA_CLASSIFIER_LATIN_RATIO=0.35
# EVA_CLASSIFIER_MARKERS=почему,объясни,сравни,напиши код,переведи,посчитай
